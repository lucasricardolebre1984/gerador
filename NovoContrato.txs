import React, { useState } from ‘react’;
import { useNavigate } from ‘react-router-dom’;
import { generateContractPDF } from ‘../utils/pdfGenerator’;

const NovoContrato = () => {
const navigate = useNavigate();
const [loading, setLoading] = useState(false);

// Dados do Cliente
const [nomeCliente, setNomeCliente] = useState(’’);
const [cpfCnpj, setCpfCnpj] = useState(’’);
const [email, setEmail] = useState(’’);
const [endereco, setEndereco] = useState(’’);

// Valores
const [valorTotal, setValorTotal] = useState(’’);
const [valorEntrada, setValorEntrada] = useState(’’);
const [numeroParcelas, setNumeroParcelas] = useState(‘2’);
const [valorParcela, setValorParcela] = useState(’’);
const [diasVencimentoParcelas, setDiasVencimentoParcelas] = useState(‘60,90’);

// Prazo
const [prazoExecucao, setPrazoExecucao] = useState(‘45-60’);

const handleSubmit = async (e: React.FormEvent) => {
e.preventDefault();

```
if (!nomeCliente || !cpfCnpj || !valorTotal) {
  alert('Preencha todos os campos obrigatórios');
  return;
}

setLoading(true);

try {
  const contractData = {
    id: Date.now().toString(),
    tipo: 'Prestação de Serviços',
    cliente: nomeCliente,
    cpfCnpj,
    email,
    endereco,
    valorTotal: parseFloat(valorTotal),
    valorEntrada: parseFloat(valorEntrada),
    numeroParcelas: parseInt(numeroParcelas),
    valorParcela: parseFloat(valorParcela),
    diasVencimentoParcelas,
    prazoExecucao,
    data: new Date().toISOString(),
    local: 'São Paulo',
  };

  // Salvar no localStorage
  const saved = localStorage.getItem('contratos');
  const contracts = saved ? JSON.parse(saved) : [];
  contracts.unshift(contractData);
  localStorage.setItem('contratos', JSON.stringify(contracts));

  // Gerar PDF
  await generateContractPDF(contractData);

  alert('Contrato gerado com sucesso!');
  navigate('/dashboard');
} catch (error) {
  console.error('Erro ao gerar contrato:', error);
  alert('Erro ao gerar contrato');
} finally {
  setLoading(false);
}
```

};

